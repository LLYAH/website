<head><meta charset="utf-8"><title>Prophetic Words &middot; Archive</title>
<!--[if gte mso 9]><xml><w:WordDocument><w:View>Print</w:View><w:Zoom>100</w:Zoom></w:WordDocument></xml><![endif]-->
<style>@page{size:8.5in 11in;margin:0.85in}
  body{margin:0}
  doc-page{--ink:#1A1917}
