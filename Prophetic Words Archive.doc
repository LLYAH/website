  .rule{height:1px;background:rgba(43,35,32,.18);margin:0 0 22pt}
  .entry{break-inside:avoid;page-break-inside:avoid;margin:0 0 24pt;padding:0 0 20pt;border-bottom:1px solid rgba(43,35,32,.12)}
  .num{font-family:'Hanken Grotesk',Calibri,Arial,sans-serif;font-size:8.5pt;font-weight:700;letter-spacing:1.6pt;text-transform:uppercase;color:#A288D8;margin:0 0 7pt}
  .word{font-family:'Hanken Grotesk',Calibri,Arial,sans-serif;font-size:14.5pt;line-height:1.35;color:#1A1917;margin:0 0 14pt;font-weight:600}
