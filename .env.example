# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── PayPal (REST app credentials from developer.paypal.com) ───────────────
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx
# live | sandbox
PAYPAL_ENV=live
# optional: enables signature verification on the PayPal webhook
PAYPAL_WEBHOOK_ID=xxx

# ── Optional: email receipts (Resend) ────────────────────────────────────
RESEND_API_KEY=re_xxx
RECEIPT_FROM="Love & Love YAH <giving@loveandloveyah.com>"
DONATION_NOTIFY_TO=giving@loveandloveyah.com
ORDER_NOTIFY_TO=orders@loveandloveyah.com

# ── Optional: hand sales tax to Stripe Tax instead of the flat 7% estimate
STRIPE_TAX=1

# ── Optional: order/donation ledger (Supabase Postgres) ──────────────────
# Provisioned via `vercel integration add supabase`, which sets this (and
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY) automatically.
# If unset, orders/donations are only logged to the function logs.
POSTGRES_URL=postgres://...
